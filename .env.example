# 서버 포트
PORT=3000

# V-World(브이월드) Open API 인증키
# https://www.vworld.kr/dev 에서 회원가입 후 "OpenAPI 인증키 신청"으로 발급받으세요.
# 인증키는 신청 시 등록한 도메인에서만(또는 서버 IP 기준으로) 동작하므로,
# 이 서버를 배포하는 도메인/IP를 V-World에 함께 등록해야 합니다.
VWORLD_API_KEY=

# 인증키 신청 시 등록한 도메인 (선택, 등록해두면 함께 전송합니다)
VWORLD_DOMAIN=

# 기본으로 조회할 토지이용 관련 데이터셋 코드
# V-World 개발자센터 > 데이터 API 문서에서 실제 제공되는 데이터셋 코드를 확인 후 필요에 맞게 바꾸세요.
# 예: 용도지역지구 관련 레이어, 연속지적도(지목) 레이어 등 (계정/서비스 제공 범위에 따라 다를 수 있음)
VWORLD_LANDUSE_DATA=LT_C_UQ111
